# Go API — copy to .env.local for local dev.
# cp .env.example .env.local

ENV=development
PORT=8080

# PostgreSQL (local Docker default below)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/epsilon?sslmode=disable

# Production (Neon): use sslmode=require. The API auto-appends prefer_simple_protocol=true
# for neon.tech / pooler hosts (required for transaction-mode poolers + sqlc).
# Example: postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Cookie / proxy
COOKIE_SECURE=false
# Leave empty for localhost (host-only cookie). Set to ".yourdomain.com" in production.
COOKIE_DOMAIN=
TRUST_PROXY=false

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# Email (Resend)
RESEND_API_KEY=
EMAIL_RENDER_PORT=3001
EMAIL_RENDER_URL=http://localhost:3001

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Sentry
SENTRY_DSN_BACKEND=