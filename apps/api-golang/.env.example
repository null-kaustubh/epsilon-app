# Go API — copy to .env.local for local dev.
# cp .env.example .env.local

ENV=development
PORT=8080

# PostgreSQL (local Docker default below)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/epsilon?sslmode=disable

# Cookie / proxy
COOKIE_SECURE=false
TRUST_PROXY=false

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# Email (Resend)
RESEND_API_KEY=
EMAIL_RENDER_PORT=3001
EMAIL_RENDER_URL=http://localhost:3001

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
