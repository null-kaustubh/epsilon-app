# Next.js web app — copy to .env.local for local dev.
# cp .env.example .env.local

# API base URL (must match in production — same host/scheme for browser + Vercel SSR)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-only (set to the same value as NEXT_PUBLIC_API_URL on Vercel)
API_URL=http://localhost:8080

# Public assets
NEXT_PUBLIC_LOGO_WHITE_IMAGE=
NEXT_PUBLIC_OG_IMAGE=
NEXT_PUBLIC_DEFAULT_SPACE_ICON=
